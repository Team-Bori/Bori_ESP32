CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# 릴리스 빌드는 크기 최적화(-Os)를 쓴다.
#
# 참고: 부팅 직후 "Cache disabled but cached memory region accessed"로 무한 재부팅하던
# 문제는 최적화 옵션과 무관했다. 한글 경로 대응으로 수정된 ESP-IDF tools/ldgen/ldgen.py가
# IRAM 배치 규칙(noflash)을 누락시켜 esp_cpu_compare_and_set 등이 플래시에 배치된 것이 원인.
# 원본 ldgen.py를 쓰고, 프로젝트는 공백/한글이 없는 경로(예: C:\project\Bori_ESP32)에서 빌드할 것.
# 확인: xtensa-esp32-elf-nm build/mlp_esp32.elf | grep esp_cpu_compare_and_set -> 0x4008xxxx(IRAM)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# CONFIG_COMPILER_OPTIMIZATION_DEBUG is not set

# JSON 출력과 사람이 읽는 로그(ESP_LOGI)를 함께 쓰므로 메인 태스크 스택을 넉넉히 둔다.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
