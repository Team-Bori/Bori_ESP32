// Ops registered in the tflm_runtime op resolver.
//
// BORI_OP(<MicroMutableOpResolver Add* suffix>, <tflite BuiltinOperator name>)
//
// This file is the single source of truth: main/runtime.cc registers these ops,
// and pc/bori_package.py reads this file to check models on the host.
// Adding an op here needs a firmware rebuild; update docs/ADDING_A_MODEL.md too.
BORI_OP(Abs, ABS)
BORI_OP(Add, ADD)
BORI_OP(AddN, ADD_N)
BORI_OP(ArgMax, ARG_MAX)
BORI_OP(ArgMin, ARG_MIN)
BORI_OP(AveragePool2D, AVERAGE_POOL_2D)
BORI_OP(BatchMatMul, BATCH_MATMUL)
BORI_OP(BatchToSpaceNd, BATCH_TO_SPACE_ND)
BORI_OP(Cast, CAST)
BORI_OP(Concatenation, CONCATENATION)
BORI_OP(Conv2D, CONV_2D)
BORI_OP(DepthToSpace, DEPTH_TO_SPACE)
BORI_OP(DepthwiseConv2D, DEPTHWISE_CONV_2D)
BORI_OP(Dequantize, DEQUANTIZE)
BORI_OP(Div, DIV)
BORI_OP(Elu, ELU)
BORI_OP(Equal, EQUAL)
BORI_OP(Exp, EXP)
BORI_OP(ExpandDims, EXPAND_DIMS)
BORI_OP(Fill, FILL)
BORI_OP(Floor, FLOOR)
BORI_OP(FullyConnected, FULLY_CONNECTED)
BORI_OP(Gather, GATHER)
BORI_OP(Greater, GREATER)
BORI_OP(HardSwish, HARD_SWISH)
BORI_OP(L2Normalization, L2_NORMALIZATION)
BORI_OP(LeakyRelu, LEAKY_RELU)
BORI_OP(Less, LESS)
BORI_OP(Log, LOG)
BORI_OP(LogSoftmax, LOG_SOFTMAX)
BORI_OP(Logistic, LOGISTIC)
BORI_OP(MaxPool2D, MAX_POOL_2D)
BORI_OP(Maximum, MAXIMUM)
BORI_OP(Mean, MEAN)
BORI_OP(Minimum, MINIMUM)
BORI_OP(MirrorPad, MIRROR_PAD)
BORI_OP(Mul, MUL)
BORI_OP(Neg, NEG)
BORI_OP(Pack, PACK)
BORI_OP(Pad, PAD)
BORI_OP(PadV2, PADV2)
BORI_OP(Prelu, PRELU)
BORI_OP(Quantize, QUANTIZE)
BORI_OP(ReduceMax, REDUCE_MAX)
BORI_OP(Relu, RELU)
BORI_OP(Relu6, RELU6)
BORI_OP(Reshape, RESHAPE)
BORI_OP(ResizeBilinear, RESIZE_BILINEAR)
BORI_OP(ResizeNearestNeighbor, RESIZE_NEAREST_NEIGHBOR)
BORI_OP(Rsqrt, RSQRT)
BORI_OP(Shape, SHAPE)
BORI_OP(Slice, SLICE)
BORI_OP(Softmax, SOFTMAX)
BORI_OP(SpaceToBatchNd, SPACE_TO_BATCH_ND)
BORI_OP(SpaceToDepth, SPACE_TO_DEPTH)
BORI_OP(Split, SPLIT)
BORI_OP(SplitV, SPLIT_V)
BORI_OP(Sqrt, SQRT)
BORI_OP(Square, SQUARE)
BORI_OP(SquaredDifference, SQUARED_DIFFERENCE)
BORI_OP(Squeeze, SQUEEZE)
BORI_OP(StridedSlice, STRIDED_SLICE)
BORI_OP(Sub, SUB)
BORI_OP(Sum, SUM)
BORI_OP(Svdf, SVDF)
BORI_OP(Tanh, TANH)
BORI_OP(Transpose, TRANSPOSE)
BORI_OP(TransposeConv, TRANSPOSE_CONV)
BORI_OP(UnidirectionalSequenceLSTM, UNIDIRECTIONAL_SEQUENCE_LSTM)
